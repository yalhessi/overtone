  add(associator(multiply(sk_dag_2, sk_dag_3), sk_dag_4, sk_dag_1), associator(commutator(sk_dag_2, sk_dag_3), sk_dag_4, sk_dag_1)) (peak)
= { by lemma 5 }
  associator(multiply(sk_dag_3, sk_dag_2), sk_dag_4, sk_dag_1)

