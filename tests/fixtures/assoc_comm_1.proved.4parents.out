Axiom 1 (commutativity_for_addition): add(X, Y) = add(Y, X).
Axiom 2 (parent_2): add(commutator(X, Y), multiply(X, Y)) = multiply(Y, X).
Axiom 3 (parent_1): associator(add(X, Y), Z, W) = add(associator(X, Z, W), associator(Y, Z, W)).

Lemma 4: add(multiply(X, Y), commutator(X, Y)) = multiply(Y, X).
Proof:
  add(multiply(X, Y), commutator(X, Y)) (peak)
= { by axiom 1 (commutativity_for_addition) R->L }
  add(commutator(X, Y), multiply(X, Y))
= { by axiom 2 (parent_2) }
  multiply(Y, X)

Lemma 5: add(associator(multiply(Y, X), Z, W), associator(commutator(Y, X), Z, W)) = associator(multiply(X, Y), Z, W).
Proof:
  add(associator(multiply(Y, X), Z, W), associator(commutator(Y, X), Z, W)) (peak)
= { by axiom 3 (parent_1) R->L }
  associator(add(multiply(Y, X), commutator(Y, X)), Z, W)
= { by lemma 4 }
  associator(multiply(X, Y), Z, W)

