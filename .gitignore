# Environment
.env
__pycache__/
*.py[cod]
.venv/
venv/

# Corpora: fetched by scripts/fetch_external.py, not tracked
data/TPTP-v*/
data/external/
data/*.tgz

# twee output; grows to GBs
logs/

# Experiment outputs (summaries are promoted to results/ deliberately)
experiments/**/out/
scratch/

.DS_Store
.vscode/
.idea/

# Per-run twee output from overtone.runner (grows to GBs)
runs/
build/

# Raw twee stdout under examples/ -- multi-MB each, and not reproducible run to
# run (twee schedules maintenance by CPU time, see docs/FINDINGS.md). The
# generated .p/.tptp/.md/.json are the artifacts worth tracking and diffing.
examples/**/*.out
